<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Scanning overlay frame -->
    <View
        android:id="@+id/scan_overlay"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/scan_overlay_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42"/>

    <!-- Animated laser line -->
    <View
        android:id="@+id/laser_line"
        android:layout_width="240dp"
        android:layout_height="3dp"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="@id/scan_overlay"
        app:layout_constraintStart_toStartOf="@id/scan_overlay"
        app:layout_constraintEnd_toEndOf="@id/scan_overlay"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/tv_scan_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Align QR or Barcode inside the frame"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:background="#66000000"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/scan_overlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Top toolbar -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QR Scanner"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Flash button -->
    <ImageButton
        android:id="@+id/btn_flash"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_flash_off"
        android:background="@drawable/circle_button_bg"
        android:padding="12dp"
        android:contentDescription="Toggle Flash"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_flip_camera"/>

    <!-- Flip camera button -->
    <ImageButton
        android:id="@+id/btn_flip_camera"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_flip_camera"
        android:background="@drawable/circle_button_bg"
        android:padding="12dp"
        android:contentDescription="Flip Camera"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
