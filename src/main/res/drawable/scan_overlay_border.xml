<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Transparent center -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="#FFFFFF"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <!-- Top-left corner -->
    <item android:top="0dp" android:left="0dp" android:bottom="220dp" android:right="220dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="4dp" android:color="@color/colorPrimary"/>
        </shape>
    </item>
    <!-- Top-right corner -->
    <item android:top="0dp" android:left="220dp" android:bottom="220dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="4dp" android:color="@color/colorPrimary"/>
        </shape>
    </item>
    <!-- Bottom-left corner -->
    <item android:top="220dp" android:left="0dp" android:bottom="0dp" android:right="220dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="4dp" android:color="@color/colorPrimary"/>
        </shape>
    </item>
    <!-- Bottom-right corner -->
    <item android:top="220dp" android:left="220dp" android:bottom="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="4dp" android:color="@color/colorPrimary"/>
        </shape>
    </item>
</layer-list>
